@charset "utf-8";

.symbol_box { display: inline-block; width: 100%; margin-top: 10px; }

.symbol_box .img { width: 25%; float: left; }

.symbol_box .img img { width: 100%; height: 100%; }

.symbol_box .txt { width: 72%; float: right; }

.intro_txt { width: 100%; height: 90px; margin-top: 10px; text-align: center; background: url("/images/ap/ss/intro_bg.png") 50% 50% / 99% 100% no-repeat; }

.intro_txt p { padding-top: 35px; font-size: 20px; font-family: NanumBold; }

.intro_txt2 { position: relative; font-size: 20px; text-align: center; padding: 10px; color: rgb(85, 85, 85); font-family: NanumBold; }

.symbol_box2 { display: inline-block; width: 100%; margin-top: 10px; }

.symbol_box2 li { width: 33.3%; height: 338px; float: left; text-align: center; background: url("/images/ap/ss/symbol_bg.png") 50% 50% no-repeat; }

.symbol_box2 li p { width: 160px; height: 160px; border-radius: 150px; background: rgb(221, 221, 221); margin: 10px auto; }

.symbol_box2 li.m1 p { background: url("/images/ap/ss/symbol_01.png") 50% 50% / 105% auto no-repeat; }

.symbol_box2 li.m2 p { background: url("/images/ap/ss/symbol_02.png") 50% 50% / 105% auto no-repeat; }

.symbol_box2 li.m3 p { background: url("/images/ap/ss/symbol_03.png") 50% 50% / 105% auto no-repeat; }

.symbol_box2 li dl { display: block; margin: 65px 50px 0px; height: 80px; overflow-y: hidden; }

.symbol_box2 li dl dt { margin-bottom: 10px; font-size: 15px; color: rgb(0, 129, 210); font-family: NanumBold; }

.intro_music { text-align: center; }

.intro_music img { margin-top: 10px; width: 80%; }

.tit_01 { font-size: 17px; line-height: 1.4; font-family: NanumBold; color: rgb(27, 76, 162); background: url("/images/ap/ss/bul_01.png") 0px 7px no-repeat; padding-top: 15px; }

.tit_02 { font-size: 15px; line-height: 1.4; font-family: NanumBold; color: rgb(17, 17, 17); background: url("/images/ap/ss/bul_03.png") 0px 5px no-repeat; padding-left: 16px; }

.bu_list_01 li { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/bu_dot.gif") left 7px no-repeat; padding-left: 12px; }

.bu_list_02 li { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/gray_dot.gif") left 7px no-repeat; padding-left: 10px; }

.bu_list_03 li { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/bu_minus.gif") left 7px no-repeat; padding-left: 10px; }

.bu_arr { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/blue_arrow.png") left 6px no-repeat; padding-left: 12px; }

.bu_01 { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/bu_dot.gif") left 7px no-repeat; padding-left: 12px; }

.bu_02 { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/gray_dot.gif") left 7px no-repeat; padding-left: 10px; }

.bu_03 { font-size: 13px; color: rgb(68, 68, 68); line-height: 1.4; margin: 5px 0px; font-family: Nanum; background: url("/images/ap/ss/bu_minus.gif") left 7px no-repeat; padding-left: 10px; }

.img_txt1 { position: relative; width: 100%; overflow: hidden; }

.img_txt1 .img { width: 10%; float: left; }

.img_txt1 .txt { width: 85%; float: right; }

.img_txt2 { position: relative; width: 100%; overflow: hidden; }

.img_txt2 .img { width: 20%; float: left; }

.img_txt2 .txt { width: 75%; float: right; }

.img_txt3 { position: relative; width: 100%; overflow: hidden; }

.img_txt3 .img { width: 30%; float: left; }

.img_txt3 .txt { width: 65%; float: right; }

.img_txt4 { position: relative; width: 100%; overflow: hidden; }

.img_txt4 .img { width: 40%; float: left; }

.img_txt4 .txt { width: 55%; float: right; }

.ff_NG { font-size: 13px; line-height: 1.4; font-family: Nanum !important; }

.gry_box { font-family: NanumBold; font-size: 20px; line-height: 1.4; padding: 15px; border: 1px solid rgb(200, 209, 219); background: rgb(247, 247, 247); }

.txt_box { font-family: Nanum; font-size: 13px; line-height: 1.4; padding: 15px; border: 1px solid rgb(200, 209, 219); }

@media screen and (max-width: 749px) {
  .symbol_box2 li { width: 50%; margin-top: 10px; }
}

@media screen and (max-width: 480px) {
  .symbol_box2 li { width: 100%; }
}
