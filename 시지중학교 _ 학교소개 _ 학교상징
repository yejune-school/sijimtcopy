  .process > div:nth-of-type(3n)::after, .process dl:nth-of-type(3n)::after { display: block; }
  .process > div:nth-of-type(2n)::after, .process dl:nth-of-type(2n)::after { display: none; }
  .cont_sitemap_row .sitemap { width: 100%; margin: 0px 0px 1rem; float: none; }
}

@media screen and (max-width: 580px) {
  .grtBox .inner { display: block; padding: 1.5rem 1rem; min-height: 0px; font-size: 1.05rem; text-align: center; border-radius: 1.5rem 1.5rem 1.5rem 0px; }
  .grtWrap.grtImg .grtBox .inner { padding-top: 0px; }
  .grtWrap.grtImg { margin-top: 3rem; }
  .grtBox .inner .img { position: relative; right: auto; bottom: auto; margin: -3rem 0px 1rem; width: auto; display: inline-block; text-align: center; }
  .grtBox .inner .img::before { bottom: -1.25rem; right: -1.5rem; transform: rotate(15deg); }
  .grtBox .inner .img p { display: inline-block; max-width: 8rem; border-radius: 1rem 1rem 1rem 0px; }
  .grtTxt { margin: 2rem 0px 0px; }
  .grtBox .inner > p, .grtTxt p:first-of-type { margin: 0px !important; }
  .empInfo { display: block; }
  .empInfo .wrap { width: 100%; }
  .empInfo .wrap:nth-of-type(2n) { margin-left: 0%; }
  .classRoom { width: 100%; margin: 0px; display: block; }
  .classRoom dl { width: 100%; padding: 0px; }
  .classRoom dd { margin-top: 0.25rem; min-height: 0px; }
  .classRoom dd li:last-of-type { border-bottom: 0px; }
  .todaymeal .date { min-width: 8rem; }
  .todaymeal .inner { min-width: calc(100% - 8rem); padding: 1rem; }
  .todaymeal .inner dl { padding: 0px; }
  .todaymeal .inner dt { position: relative; left: auto; top: auto; min-width: 4rem; height: 2rem; border-radius: 0.5rem 0px; margin-bottom: 0.5rem; }
  .cmtDclr .list .user { padding-right: 1rem; }
  .cmtDclr .list .user > span { display: block; width: 100%; position: relative; right: auto; top: auto; line-height: 1.4; font-size: 13px; }
}

@media screen and (max-width: 480px) {
  .historylst dt { padding: 0.4rem 1rem; }
  .historylst dd { padding: 1rem; }
  .historylst li { flex-direction: column; }
  .historylst li + li { margin-top: 1rem; }
  .historylst li span { min-width: 0px; width: 100%; margin-bottom: 0.25rem; }
  .fcltyInfo .inner { padding: 1.5rem 0.25rem 0.5rem; }
  .fcltyInfo li { padding: 0.5rem 0.25rem; width: 50% !important; }
  .fcltyInfo li .img { border-radius: 0.75rem; }
  .symbol.typeA .info h4 span { min-width: 4rem; }
  .symbol.typeB .symbolList { width: 100%; margin: 0px; }
  .symbol.typeB .wrap { width: 100%; padding: 0px; }
  .symbol.typeB .info { min-height: auto; }
  .todaymeal .tit { display: block; }
  .todaymeal .tit p::before { width: 0.75rem; margin: 0px 0.5rem; }
  .todaymeal .wrap { display: block; }
  .todaymeal .date { min-width: 0px; border-radius: 1rem 1rem 0px; text-align: left; padding: 0.75rem 1.5rem; background-position: 95% bottom; background-size: auto 80px; }
  .todaymeal .inner { min-width: 0px; border-radius: 1rem 0px; }
  .eduSupt .lstTy01 strong { min-width: 5rem; }
  .eduSupt .lstTy01 p a { padding: 0px 0.5rem; }
  .eduSupt .linklst li { width: calc(33.3333%); }
  .eduSupt .linklst a p { width: 4rem; height: 4rem; line-height: 4rem; }
  .eduSupt .linklst a p img { width: 50px; height: 50px; }
  .eduSupt .totalSrch { display: block; }
  .eduSupt .totalSrch .check { width: 100%; min-width: 0px; }
  .eduSupt .totalSrch .search { width: 100%; margin-top: 0.5rem; }
  .eduSupt .sitelst div > p { width: 100%; }
  .eduSupt .sitelst div > p + p { margin-top: 0.5rem; margin-left: 0px; }
  .cmtDclr .agrForm .txt br { display: none; }
  .cmtDclr .list li > p { margin-left: 0px; }
  .cmtWrite .list .user::before { margin: 0px; }
  .cmtWrite .list .user span { display: block; padding-left: 1rem; }
  .cmtRank .rankTop { padding: 0px 0.75rem 1rem; }
  .process > div, .process dl { margin-bottom: 2rem; flex-basis: 100% !important; margin-right: 0px !important; }
  .process > div { margin-bottom: 2rem !important; }
  .process > div:nth-of-type(2n)::after, .process dl:nth-of-type(2n)::after { display: block; }
  .process > div::after, .process dl::after { top: auto; bottom: -1.5rem; right: 50%; margin-right: -1rem; transform: rotate(90deg); }
  .process > div.last, .process dl.last { margin-bottom: 0px !important; }
}

@media screen and (max-width: 380px) {
  .cmtDclr .list .user > p { display: block; }
  .cmtWrite .form li { padding-left: 0px; }
  .cmtWrite .form li > em { position: relative; left: 0px; top: 0px; display: block; }
  .cmtWrite .list dd { padding: 1rem 0px 0px; }
  .cmtWrite .list dd .like { display: block; }
}
